rules_version = '2';

// Public comment wall:
// - anyone can read comments
// - anyone can add one, only with a name (1-40 characters), a message (1-500 characters)
//   and the server's own timestamp
// - nobody can edit or delete from the website; Panji deletes comments in the Firebase console
// - everything else in the database is closed
service cloud.firestore {
  match /databases/{database}/documents {
    match /comments/{commentId} {
      // anyone can open single comments; lists are capped at 50 per request (the site asks for 30)
      allow get: if true;
      allow list: if request.query.limit <= 50;
      allow create: if request.resource.data.keys().hasOnly(['name', 'message', 'createdAt'])
        && request.resource.data.keys().hasAll(['name', 'message', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.trim().size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.trim().size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
